<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CarRentalApp</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\posters\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Явная привязка Designer.cs к основной форме -->
  <ItemGroup>
    <Compile Update="MainForm.Designer.cs">                <DependentUpon>MainForm.cs</DependentUpon>         </Compile>
    <Compile Update="Forms\KlientyForm.Designer.cs">      <DependentUpon>KlientyForm.cs</DependentUpon>      </Compile>
    <Compile Update="Forms\SotrudnikiForm.Designer.cs">   <DependentUpon>SotrudnikiForm.cs</DependentUpon>   </Compile>
    <Compile Update="Forms\DolzhnostiForm.Designer.cs">   <DependentUpon>DolzhnostiForm.cs</DependentUpon>   </Compile>
    <Compile Update="Forms\MarkiForm.Designer.cs">        <DependentUpon>MarkiForm.cs</DependentUpon>        </Compile>
    <Compile Update="Forms\UslugiForm.Designer.cs">       <DependentUpon>UslugiForm.cs</DependentUpon>       </Compile>
    <Compile Update="Forms\AvtomobiliForm.Designer.cs">   <DependentUpon>AvtomobiliForm.cs</DependentUpon>   </Compile>
    <Compile Update="Forms\ProkatForm.Designer.cs">       <DependentUpon>ProkatForm.cs</DependentUpon>       </Compile>
  </ItemGroup>

  <!-- Явная привязка .resx к формам как Embedded Resource -->
  <ItemGroup>
    <EmbeddedResource Update="Forms\KlientyForm.resx">      <DependentUpon>KlientyForm.cs</DependentUpon>      </EmbeddedResource>
    <EmbeddedResource Update="Forms\SotrudnikiForm.resx">   <DependentUpon>SotrudnikiForm.cs</DependentUpon>   </EmbeddedResource>
    <EmbeddedResource Update="Forms\DolzhnostiForm.resx">   <DependentUpon>DolzhnostiForm.cs</DependentUpon>   </EmbeddedResource>
    <EmbeddedResource Update="Forms\MarkiForm.resx">        <DependentUpon>MarkiForm.cs</DependentUpon>        </EmbeddedResource>
    <EmbeddedResource Update="Forms\UslugiForm.resx">       <DependentUpon>UslugiForm.cs</DependentUpon>       </EmbeddedResource>
    <EmbeddedResource Update="Forms\AvtomobiliForm.resx">   <DependentUpon>AvtomobiliForm.cs</DependentUpon>   </EmbeddedResource>
    <EmbeddedResource Update="Forms\ProkatForm.resx">       <DependentUpon>ProkatForm.cs</DependentUpon>       </EmbeddedResource>
  </ItemGroup>
</Project>
